# Copy this file to .env.local for local development.
# Do not commit real secrets.

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database (Neon/PostgreSQL)
# Runtime URL: use POOLED connection string from Neon (hostname contains -pooler)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Migration URL: use DIRECT connection string only (hostname has NO -pooler)
# Required for drizzle-kit migrate / db:generate. Do not use the pooled URL here.
MIGRATION_DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Better Auth
# Example secret generation: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_long_random_secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional until auth module is implemented)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail API OAuth app (shared by the platform sender and every shop's Gmail connection)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Owner Gmail Connection: must match an Authorized redirect URI on the Gmail OAuth client.
GMAIL_REDIRECT_URI=http://localhost:3000/api/settings/gmail/callback
# AES-256-GCM key for stored Gmail refresh tokens: 32 bytes, base64. Generate: openssl rand -base64 32
# Changing it makes every stored connection unreadable (owners must reconnect).
GMAIL_TOKEN_ENCRYPTION_KEY=
# Platform sender: account-verification emails ONLY.
# Shop emails (invites, repair updates, invoices, payments) use the shop owner's connected Gmail.
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRESET_KEY=
