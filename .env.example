# Copy to .env.local and fill in. Never commit real values.
# Every new key added to the app must be added here too (code-standards.md §14).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/repairtrack

# --- Better Auth ---
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=repairtrack
